# Copy to .env and fill in the secrets. Never commit a filled .env.
# Values shown are non-secret identifiers/URLs for the reference deployment.

PORT=8080
# Public origin of this deployment (auth challenges / protected-resource metadata)
PUBLIC_BASE_URL=http://localhost:8080

# --- Databricks (Solana docs corpus, same design as the official solana-mcp) ---
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_VS_INDEX=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_WORKSPACE_ID=7474650141106372
OPENSHARING_ID=aws:us-west-2:d0651ec3-c7ce-454f-a45f-3777b1eb01d4

# --- Neon AI Gateway (the in-server AI gateway) ---
NEON_AI_GATEWAY_BASE_URL="https://br-purple-tooth-b5b1v3cb-api.ai.c-7.us-east-2.aws.neon.tech"
NEON_AI_GATEWAY_TOKEN=
AI_GATEWAY_DEFAULT_MODEL=claude-haiku-4-5

# --- Neon Auth (JWT verification for authenticated tools) ---
AUTH_URL=https://ep-rapid-credit-b5wcjum6.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth
JWKS_URL=https://ep-rapid-credit-b5wcjum6.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json

# --- Neon Data API (PostgREST; calls carry the caller's Neon Auth JWT) ---
DATA_API_URL=https://ep-rapid-credit-b5wcjum6.apirest.c-7.us-east-2.aws.neon.tech/neondb/rest/v1

# --- Neon Postgres ---
# Note for Node clients: `pg` does not support SCRAM channel binding, so the
# deployed DATABASE_URL should omit `channel_binding=require` (keep sslmode=require).
DATABASE_URL=

# --- Neon Object Storage (S3-compatible) ---
AWS_ENDPOINT_URL_S3="https://br-purple-tooth-b5b1v3cb.storage.c-7.us-east-2.aws.neon.tech"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION="us-east-2"
ASSETS_BUCKET=assets
